# 谛听阅读器 · 配置示例
# 复制为 .env 后填写；也可以直接启动应用，在「设置 → 数据源 / AI 模型」里改。
# ★ .env 含明文凭据：不要提交到 git、不要发给别人。应用内保存会自动设为 0600。

# ---------------------------------------------------------------- 数据源
# greader = FreshRSS（Google Reader API）；miniflux = Miniflux（上游默认）
DATASOURCE_ENGINE=greader

# FreshRSS：后台开启 API，个人资料页生成「专用 API 密码」（不是网页登录密码）
# 地址形如 https://your-freshrss-host/api/greader.php
GREADER_BASE_URL=
GREADER_USERNAME=
GREADER_PASSWORD=

# Miniflux（切换时把 DATASOURCE_ENGINE 改成 miniflux）
MINIFLUX_URL=http://localhost:8080
MINIFLUX_ADMIN_USERNAME=
MINIFLUX_ADMIN_PASSWORD=

# ---------------------------------------------------------------- AI 模型
# deepseek（默认）| agnes；不填 key 时分级/日报降级为规则版
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ---------------------------------------------------------------- 阅读与刷新
READER_ENTRY_WINDOW=200
READER_MULTI_FEED_PER_SOURCE=60
READER_TREE_CACHE_TTL=20
READER_UNRATED_LEVEL=2

# FreshRSS 缓存（0 关闭；条目缓存只作用于 UI 规模列表）
GREADER_ENTRY_CACHE_TTL=15
GREADER_ENTRY_CACHE_MAX=12
GREADER_ICON_MISS_TTL=300
GREADER_ICON_MAX_BYTES=262144

# FreshRSS 没有抓取完成时间：日报最多等源刷新多少分钟（0 = 不等）
SUMMARY_FRESH_DEADLINE_MIN=0
FAST_REFRESH_ENABLED=1

# ---------------------------------------------------------------- 本机访问
# 默认只听 127.0.0.1。需要局域网/VPN 访问时再放开（对外前必须关 DEBUG）：
DJANGO_DEBUG=1
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_SECRET_KEY=<random-string>
